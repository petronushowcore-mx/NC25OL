    "domain": {
      "domain_name": "OTCS registry connection reference profile",
      "description": "An interoperability profile in which NC2.5 defines the admissibility atmosphere and issues the execution permit. OTCS supplies typed rights receipts and an exact project head, then performs only the permitted compare-and-swap append and returns a content-addressed receipt."
    },
    "action_alphabet": [
      {
        "action_id": "OTCS_APPEND_EVENT",
        "description": "Append one content-addressed event to the declared OTCS project stream after NC2.5 admission.",
        "effect_class_id": "OTCS_REGISTRY_MUTATION",
        "structural_cost": 50,
        "required_resource_ids": [
          "otcs_append_units"
        ]
      },
      {
        "action_id": "NO_EFFECT_FALLBACK",
        "description": "Record a non-mutating fallback without contacting OTCS.",
        "effect_class_id": "NO_EFFECT",
        "structural_cost": 0,
        "required_resource_ids": []
      }
    ],
    "effect_classes": [
      {
        "effect_class_id": "OTCS_REGISTRY_MUTATION",
