{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nc25.local/universal-ledger/registry-record.schema.json",
  "title": "NC25OL Connection Hash-Only Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_id",
    "profile_id",
    "profile_version",
    "profile_hash",
    "declaration_id",
    "declaration_version",
    "declaration_hash",
    "core_anchor",
    "status",
    "activated_at",
    "revoked",
    "ledger_head_hash",
    "latest_receipt_root"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "connector_id": {
      "$ref": "#/$defs/identifier"
    },
    "profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "profile_version": {
      "$ref": "#/$defs/version"
    },
    "profile_hash": {
      "$ref": "#/$defs/sha256"
    },
    "declaration_id": {
      "$ref": "#/$defs/identifier"
    },
    "declaration_version": {
      "$ref": "#/$defs/version"
    },
    "declaration_hash": {
      "$ref": "#/$defs/sha256"
    },
    "core_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_version",
        "doi",
        "sha256"
      ],
      "properties": {
        "core_version": {
          "const": "3.0"
        },
        "doi": {
          "const": "10.17605/OSF.IO/NHTC5"
        },
        "sha256": {
          "const": "20F1EA17E0B986627CAD9AFA7C02E1DC5088C43A779435E5A38F11E43A06C9C3"
        }
      }
    },
    "status": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUSPENDED",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "activated_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "revoked": {
      "type": "boolean"
    },
    "ledger_head_hash": {
      "$ref": "#/$defs/sha256"
    },
    "latest_receipt_root": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  }
}
